  "components": {
    "schemas": {
      "AcceptedResponse": {
        "required": [
          "message"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "ApiError": {
        "required": [
          "code",
          "message",
          "correlationId"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "errors": {
            "type": [
              "null",
              "object"
            ],
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "AuditLogItem": {
        "required": [
          "id",
          "occurredAtUtc",
          "actorUserId",
          "action",
          "targetType",
          "targetId",
          "correlationId",
          "ipAddress",
          "detailsJson"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "occurredAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "actorUserId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "action": {
            "type": "string"
          },
          "targetType": {
            "type": [
              "null",
              "string"
            ]
          },
          "targetId": {
            "type": [
              "null",
              "string"
            ]
          },
          "correlationId": {
            "type": [
              "null",
              "string"
            ]
          },
          "ipAddress": {
            "type": [
              "null",
              "string"
            ]
          },
          "detailsJson": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AuthResponse": {
        "required": [
          "accessToken",
          "accessTokenExpiresAtUtc",
          "profile"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "profile": {
            "$ref": "#/components/schemas/ProfileResponse"
          }
        }
      },
      "CapabilityType": {
        "enum": [
          "Quotes",
          "QuoteStreaming",
          "HistoricalCandles",
          "MarketDepth",
          "OptionsData",
          "Fundamentals",
          "CorporateDisclosures",
          "News",
          "InstrumentMaster"
        ]
      },
      "CompanyResponse": {
        "required": [
          "id",
          "legalName",
          "shortName",
          "sector",
          "industry",
          "isSimulated"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "legalName": {
            "type": "string"
          },
          "shortName": {
            "type": [
              "null",
              "string"
            ]
          },
          "sector": {
            "type": [
              "null",
              "string"
            ]
          },
          "industry": {
            "type": [
              "null",
              "string"
            ]
          },
          "isSimulated": {
            "type": "boolean"
          }
        }
      },
      "DeliveryMode": {
        "enum": [
          "Live",
          "Delayed",
          "EndOfDay",
          "Simulated"
        ]
      },
      "EmailRequest": {
        "required": [
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        }
      },
      "Entitlement": {
        "required": [
          "featureKey",
          "limit"
        ],
        "type": "object",
        "properties": {
          "featureKey": {
            "type": "string"
          },
          "limit": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "ExperienceMode": {
        "enum": [
          "Explore",
          "Pro"
        ]
      },
      "InstrumentPage": {
        "required": [
          "items",
          "page",
          "pageSize",
          "totalCount"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InstrumentSummary"
            }
          },
          "page": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "pageSize": {
